{
  "name": "Customer Support — Customer Identification (Phase 4)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "b001a001-0000-0000-0000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        260,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram_creds",
          "name": "Telegram Bot Account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "id_tel_id",
              "name": "telegram_id",
              "value": "={{ String($json.message.from.id) }}",
              "type": "string"
            },
            {
              "id": "id_chat_id",
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}",
              "type": "string"
            },
            {
              "id": "id_first_name",
              "name": "first_name",
              "value": "={{ $json.message.from.first_name || '' }}",
              "type": "string"
            },
            {
              "id": "id_username",
              "name": "username",
              "value": "={{ $json.message.from.username || '' }}",
              "type": "string"
            },
            {
              "id": "id_customer_name",
              "name": "customer_name",
              "value": "={{ ($json.message.from.first_name ? ($json.message.from.first_name + ' ' + ($json.message.from.last_name || '')).trim() : ($json.message.from.username || 'Customer')) }}",
              "type": "string"
            },
            {
              "id": "id_msg_text",
              "name": "message_text",
              "value": "={{ $json.message.text || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b001a001-0000-0000-0000-000000000002",
      "name": "Step 18: Extract Customer Information",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/customers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "telegram_id",
              "value": "={{ 'eq.' + $json.telegram_id }}"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b001a001-0000-0000-0000-000000000003",
      "name": "Step 19: Search Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ Array.isArray($json) ? $json.length : ($json.id ? 1 : 0) }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "b001a001-0000-0000-0000-000000000004",
      "name": "Step 20: Customer Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Step 18: Extract Customer Information').item.json.chat_id }}",
        "text": "={{ '👋 Welcome back, ' + (Array.isArray($json) ? $json[0].name : $json.name) + '! Your profile was found in our database.' }}",
        "additionalFields": {}
      },
      "id": "b001a001-0000-0000-0000-000000000005",
      "name": "Reply Existing Customer",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1140,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram_creds",
          "name": "Telegram Bot Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/customers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $('Step 18: Extract Customer Information').item.json.customer_name }}\",\n  \"telegram_id\": \"{{ $('Step 18: Extract Customer Information').item.json.telegram_id }}\",\n  \"channel\": \"telegram\",\n  \"status\": \"active\"\n}",
        "options": {}
      },
      "id": "b001a001-0000-0000-0000-000000000006",
      "name": "Step 20: Create Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        400
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Step 18: Extract Customer Information').item.json.chat_id }}",
        "text": "={{ '🎉 Nice to meet you, ' + (Array.isArray($json) ? $json[0].name : $json.name) + '! A new customer record has been created for you.' }}",
        "additionalFields": {}
      },
      "id": "b001a001-0000-0000-0000-000000000007",
      "name": "Reply New Customer Created",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1360,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram_creds",
          "name": "Telegram Bot Account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Step 18: Extract Customer Information",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 18: Extract Customer Information": {
      "main": [
        [
          {
            "node": "Step 19: Search Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 19: Search Supabase": {
      "main": [
        [
          {
            "node": "Step 20: Customer Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 20: Customer Exists?": {
      "main": [
        [
          {
            "node": "Reply Existing Customer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Step 20: Create Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 20: Create Customer": {
      "main": [
        [
          {
            "node": "Reply New Customer Created",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "Customer Support"
    },
    {
      "name": "Phase 4"
    }
  ]
}
