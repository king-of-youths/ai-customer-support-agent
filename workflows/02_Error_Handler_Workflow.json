{
  "name": "Customer Support — Error Handler (Phase 15)",
  "nodes": [
    {
      "parameters": {},
      "id": "e001a001-4475-472d-88f0-100000000001",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "err_wf_name",
              "name": "workflow_name",
              "value": "={{ $json.workflow?.name || 'Unknown Workflow' }}",
              "type": "string"
            },
            {
              "id": "err_wf_id",
              "name": "workflow_id",
              "value": "={{ $json.workflow?.id || 'N/A' }}",
              "type": "string"
            },
            {
              "id": "err_exec_id",
              "name": "execution_id",
              "value": "={{ $json.execution?.id || 'N/A' }}",
              "type": "string"
            },
            {
              "id": "err_message",
              "name": "error_message",
              "value": "={{ $json.execution?.error?.message || 'Unexpected failure during execution' }}",
              "type": "string"
            },
            {
              "id": "err_last_node",
              "name": "last_node",
              "value": "={{ $json.execution?.lastNodeExecuted || 'Unknown node' }}",
              "type": "string"
            },
            {
              "id": "err_time",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "err_alert_msg",
              "name": "telegram_alert_text",
              "value": "={{ '🚨 *Automation Error Alert*\\n\\n*Workflow:* `' + ($json.workflow?.name || 'Unknown') + '`\\n*Error:* ' + ($json.execution?.error?.message || 'Unknown error') + '\\n*Failed Node:* `' + ($json.execution?.lastNodeExecuted || 'Unknown') + '`\\n*Execution ID:* `' + ($json.execution?.id || 'N/A') + '`\\n*Time:* ' + $now.toFormat('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e001a001-4475-472d-88f0-100000000002",
      "name": "Format Error Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/system_logs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"{{ $json.workflow_name }}\",\n  \"event_type\": \"error\",\n  \"status\": \"failed\",\n  \"message\": \"{{ $json.error_message.replace(/\"/g, '\\\\\"') }}\",\n  \"metadata\": {\n    \"execution_id\": \"{{ $json.execution_id }}\",\n    \"last_node\": \"{{ $json.last_node }}\",\n    \"workflow_id\": \"{{ $json.workflow_id }}\"\n  }\n}",
        "options": {}
      },
      "id": "e001a001-4475-472d-88f0-100000000003",
      "name": "Log to Supabase (system_logs)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
        "text": "={{ $json.telegram_alert_text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "e001a001-4475-472d-88f0-100000000004",
      "name": "Alert Owner via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        380
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram_creds",
          "name": "Telegram Bot Account"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format Error Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Details": {
      "main": [
        [
          {
            "node": "Log to Supabase (system_logs)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alert Owner via Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "Customer Support"
    },
    {
      "name": "Error Handling"
    }
  ]
}
