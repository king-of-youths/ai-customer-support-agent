    {
      "parameters": {
        "jsCode": "// Prepare History and Context\nconst rawHistory = Array.isArray($json) ? $json.slice().reverse() : [];\nconst formattedHistory = rawHistory.map(m => `[${m.sender_type.toUpperCase()}]: ${m.message}`).join('\\n');\n\nconst session = $('Merge Session Data').item.json;\nconst userMsg = session.message_text.toLowerCase();\n\n// Fast Intent Classifier Heuristic\nlet detectedIntent = 'FAQ';\n\nif (userMsg.includes('human') || userMsg.includes('agent') || userMsg.includes('person') || userMsg.includes('representative') || userMsg.includes('operator')) {\n  detectedIntent = 'Human';\n} else if (userMsg.includes('complain') || userMsg.includes('bad') || userMsg.includes('wrong') || userMsg.includes('terrible') || userMsg.includes('angry')) {\n  detectedIntent = 'Complaint';\n} else if (userMsg.includes('book') || userMsg.includes('appointment') || userMsg.includes('schedule') || userMsg.includes('calendar') || userMsg.includes('consultation tomorrow')) {\n  detectedIntent = 'Appointment';\n} else if (userMsg.includes('hire') || userMsg.includes('buy') || userMsg.includes('interested in') || userMsg.includes('start project') || userMsg.includes('proposal')) {\n  detectedIntent = 'Lead';\n} else if (userMsg.includes('price') || userMsg.includes('how much') || userMsg.includes('cost') || userMsg.includes('rate')) {\n  detectedIntent = 'Pricing';\n} else if (userMsg.includes('product') || userMsg.includes('service') || userMsg.includes('feature') || userMsg.includes('what do you offer') || userMsg.includes('automation') || userMsg.includes('website')) {\n  detectedIntent = 'Product';\n}\n\nreturn [{\n  json: {\n    ...session,\n    history_text: formattedHistory,\n    intent: detectedIntent\n  }\n}];"
      },
      "id": "a0010001-0000-0000-0000-000000000018",
