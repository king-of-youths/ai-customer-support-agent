    {
      "parameters": {
        "jsCode": "// Prepare Knowledge Base Context & Product Context for Gemini\nconst session = $('Step 32: Detect Intent & Format Context').item.json;\nlet kbText = '';\nlet productText = '';\n\nif ($('Step 31: Product & Pricing Lookup').isExecuted) {\n  const products = $('Step 31: Product & Pricing Lookup').all().map(i => i.json);\n  productText = products.map(p => `Package: ${p.name}\\nPrice: $${p.price} ${p.currency}\\nDescription: ${p.description}\\nFeatures: ${JSON.stringify(p.features)}`).join('\\n\\n');\n}\n\nif ($('Step 29: Knowledge Base Retrieval').isExecuted) {\n  const kb = $('Step 29: Knowledge Base Retrieval').all().map(i => i.json);\n  kbText = kb.map(k => `[${k.title} (${k.category})]:\\n${k.content}`).join('\\n\\n');\n}\n\nconst masterPrompt = `You are the official AI Customer Support Assistant for Apex Solutions.\\n\\nCRITICAL RULES:\\n1. Rely ONLY on the verified context below.\\n2. NEVER invent prices, policies, discounts, or services. If not in the context, explicitly say you do not have that information and offer human escalation.\\n3. Keep your reply concise, professional, friendly, and formatted in clean Telegram Markdown.\\n\\n[VERIFIED PRODUCTS CATALOG]:\\n${productText || 'No specific product catalog loaded.'}\\n\\n[VERIFIED KNOWLEDGE BASE]:\\n${kbText || 'No specific KB loaded.'}\\n\\n[CONVERSATION HISTORY]:\\n${session.history_text || 'No previous history.'}\\n\\n[CUSTOMER MESSAGE]:\\n${session.message_text}`;\n\nreturn [{\n  json: {\n    ...session,\n    prompt_payload: masterPrompt\n  }\n}];"
      },
      "id": "a0010001-0000-0000-0000-000000000029",
