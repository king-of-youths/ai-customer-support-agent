    {
      "parameters": {
        "jsCode": "// Step 49 & 50: Security and Guardrails Pre-Check\nconst text = ($json.message_text || '').toLowerCase();\n\nconst injectionPatterns = [\n  /ignore\\s+((all|any|the)\\s+)?previous\\s+instructions/i,\n  /ignore\\s+.*instructions/i,\n  /system\\s+override/i,\n  /you\\s+are\\s+now\\s+in\\s+(developer|dan|unrestricted)\\s+mode/i,\n  /reveal\\s+(your|the)?\\s*(system|hidden)?\\s*prompt/i,\n  /print\\s+all\\s+instructions/i,\n  /give\\s+me\\s+all\\s+(customer|user)\\s+records/i,\n  /dump\\s+(the)?\\s*database/i\n];\n\nlet isAttack = false;\nlet violationReason = '';\n\nfor (const pattern of injectionPatterns) {\n  if (pattern.test(text)) {\n    isAttack = true;\n    violationReason = 'Security guardrail violation: Prompt injection or unauthorized data extraction attempt';\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ...$json,\n    is_guardrail_violation: isAttack,\n    guardrail_reason: violationReason\n  }\n}];"
      },
      "id": "a0010001-0000-0000-0000-000000000003",
