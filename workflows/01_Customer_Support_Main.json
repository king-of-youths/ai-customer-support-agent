    {
      "parameters": {
        "jsCode": "// Step 52: Validate AI Output & Hallucination Check\nlet rawReply = '';\ntry {\n  rawReply = $json.candidates[0].content.parts[0].text;\n} catch (e) {\n  rawReply = 'Thank you for reaching out. A support representative will be in touch shortly.';\n}\n\n// Guardrail verification\nlet isValid = true;\nif (!rawReply || rawReply.trim().length === 0) {\n  isValid = false;\n} else if (rawReply.includes('{{') || rawReply.includes('system prompt') || rawReply.includes('AI model')) {\n  isValid = false;\n}\n\nconst cleanReply = isValid ? rawReply.trim() : 'I apologize for any inconvenience. I have recorded your message and our team will get back to you shortly.';\n\nreturn [{\n  json: {\n    final_reply: cleanReply\n  }\n}];"
      },
