# ==========================================
# AI Customer Support Agent Environment Variables
# Copy this file to .env and populate with your credentials
# ==========================================

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key

# --- TELEGRAM BOT CONFIGURATION ---
# Obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal Telegram Chat ID for receiving admin escalation alerts (from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# --- GOOGLE GEMINI AI CONFIGURATION ---
# Obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- GOOGLE CALENDAR CONFIGURATION (for appointments) ---
# Primary calendar ID or specific support calendar ID (e.g. primary or your-email@gmail.com)
GOOGLE_CALENDAR_ID=primary
# Timezone for booking appointments
TIMEZONE=America/New_York

# --- EMAIL NOTIFICATION CONFIGURATION (Gmail / SMTP for leads & errors) ---
ADMIN_EMAIL=admin@yourdomain.com
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# --- N8N SYSTEM CONFIGURATION ---
# Public URL where n8n webhooks can be reached (e.g. ngrok, Cloudflare Tunnel, or production domain)
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com
WEBHOOK_PATH_CUSTOMER_SUPPORT=/webhook/customer-support-main
